{
  "name": "sunroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build -w apps/web && npm run build -w apps/extension && npm run build -w apps/desktop",
    "web": "npm run dev -w apps/web",
    "desktop": "npm run start -w apps/desktop",
    "eval": "node eval/run.mjs",
    "live": "node eval/live.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "^1.50.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "description": "Makes a weak webcam in bad light look good, automatically.",
  "license": "MIT"
}
