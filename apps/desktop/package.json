{
  "name": "@sunroom/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "node test/pack.test.mjs && node test/sender.test.mjs && node test/v4l2-pipe.test.mjs",
    "e2e": "node build.mjs && node test/e2e.mjs",
    "dist": "node ../web/build.mjs && node build.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "io.github.umarfarook1.sunroom",
    "extraMetadata": { "name": "sunroom", "productName": "Sunroom" },
    "asar": false,
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**", "tools/**", "vendor/**", "!node_modules/koffi/build/koffi/!(${platform}_${arch})/**"],
    "extraResources": [{ "from": "../web/dist", "to": "web/dist" }]
  },
  "dependencies": { "koffi": "^2.9.0" },
  "devDependencies": { "electron": "45.2.3", "electron-builder": "^26.18.0" }
}
